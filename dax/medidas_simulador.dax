/* ============================================================================
   PROJETO: Simulador de Índice de Perda (Fundo Garantidor de Crédito)
   DOCUMENTAÇÃO COMPLETA DE MEDIDAS DAX E PARÂMETROS
   AUTOR: Analista de Dados
   ============================================================================ */


// ============================================================================
// 01. MEDIDA: dt_intv_infr
// DESCRIÇÃO: Retorna o intervalo textual de datas formatado (dd/mm/yyyy a dd/mm/yyyy)
//            representando a janela móvel de 60 meses até a última operação registrada 
//            para o banco anonimizado selecionado.
// ============================================================================

dt_intv_infr = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
RETURN
IF(
    vBancoSelecionado, 
    VAR vUltimaDataOp = CALCULATE(MAX(OPERACOES[OPE_DATAINICIO]))
    VAR vDataFim = IF(NOT ISBLANK(vUltimaDataOp), EOMONTH(vUltimaDataOp, 0))
    VAR vDataInicio = IF(NOT ISBLANK(vDataFim), EDATE(vDataFim, -60) + 1)
    RETURN
    IF(
        ISBLANK(vDataFim), 
        "-", 
        FORMAT(vDataInicio, "dd/mm/yyyy") & " a " & FORMAT(vDataFim, "dd/mm/yyyy")
    ),
    "-"
)


// ============================================================================
// 02. MEDIDA: vlr-garantido
// DESCRIÇÃO: Soma do valor total de garantia concedida nas operações ativas, 
//            excluindo status operacionais nulos/inválidos (Cancelados: 12, 
//            Transferidos: 14 e Renegociados: 15).
// ============================================================================

vlr-garantido = 
CALCULATE(
    SUM(OPERACOES[OPE_VALORGARANTIA]),
    NOT(OPERACOES[OPE_CODIGOSITUACAO-SIT_COD_N3] IN {12, 14, 15})
)


// ============================================================================
// 03. MEDIDA: vlr-garantido_60meses
// DESCRIÇÃO: Calcula o montante total de valor garantido acumulado estritamente 
//            dentro da janela móvel retroativa dos últimos 60 meses.
// ============================================================================

vlr-garantido_60meses = 
VAR DataFinal = EOMONTH(MAX(dCalendario[Date]),0)
VAR DataInicial = EOMONTH(DataFinal,-60)+1

RETURN
    CALCULATE(
        [vlr-garantido],
        dCalendario[Date] >= DataInicial && dCalendario[Date] <= DataFinal
    )


// ============================================================================
// 04. MEDIDA: media-garantia_60meses
// DESCRIÇÃO: Média mensal do valor garantido calculada dividindo o acumulado de 
//            60 meses pela quantidade total de meses do período móvel (60).
// ============================================================================

media-garantia_60meses = [vlr-garantido_60meses] / 60


// ============================================================================
// 05. MEDIDA: vlr-honrado
// DESCRIÇÃO: Soma do valor efetivamente honrado pelo fundo garantidor, utilizando 
//            relacionamento inativo com a dCalendario via Data Efetiva de Honra e 
//            desconsiderando status não operacionais (12, 14, 15).
// ============================================================================

vlr-honrado = 
CALCULATE(
    SUM(OPERACOES[OPE_VALOREFETIVOHONRA]),
    USERELATIONSHIP(
        dCalendario[Date],
        OPERACOES[OPE_DATAEFETIVAHONRA]
    ),
    NOT(OPERACOES[OPE_CODIGOSITUACAO-SIT_COD_N3] IN {12, 14, 15})
)


// ============================================================================
// 06. MEDIDA: vlr-honrado_60meses
// DESCRIÇÃO: Calcula o volume total de honras efetivadas no intervalo de 60 meses 
//            móveis com base na data de honra.
// ============================================================================

vlr-honrado_60meses = 
VAR DataFinal = EOMONTH(MAX(dCalendario[Date]),0)
VAR DataInicial = EOMONTH(DataFinal,-60)+1

RETURN
    CALCULATE (
        [vlr-honrado],
        USERELATIONSHIP(
            dCalendario[Date],
            OPERACOES[OPE_DATAEFETIVAHONRA]
        ),
        DATESBETWEEN ( dCalendario[Date], DataInicial, DataFinal )
    )


// ============================================================================
// 07. MEDIDA: media-honra_60 meses
// DESCRIÇÃO: Média mensal do valor de honras executadas no período móvel de 60 meses.
// ============================================================================

media-honra_60 meses = [vlr-honrado_60meses] / 60


// ============================================================================
// 08. MEDIDA: vlr-recuperado
// DESCRIÇÃO: Soma dos valores de créditos recuperados pós-honra através do 
//            relacionamento ativo pela Data de Lançamento do Extrato.
// ============================================================================

vlr-recuperado = 
CALCULATE(
    SUM(VALOR_RECUPERADO[VLRRECUPERADO]),
    USERELATIONSHIP(
        dCalendario[Date],
        VALOR_RECUPERADO[EXT_DATALANCAMENTO]
    ),
    NOT(OPERACOES[OPE_CODIGOSITUACAO-SIT_COD_N3] IN {12, 14, 15})
)


// ============================================================================
// 09. MEDIDA: vlr-recuperado_60meses
// DESCRIÇÃO: Montante total recuperado pelo fundo garantidor restrito à janela 
//            móvel de 60 meses.
// ============================================================================

vlr-recuperado_60meses = 
VAR DataFinal = EOMONTH(MAX(dCalendario[Date]),0)
VAR DataInicial = EOMONTH(DataFinal,-60)+1

RETURN
    CALCULATE(
        SUM(VALOR_RECUPERADO[VLRRECUPERADO]),
        USERELATIONSHIP(
            dCalendario[Date],
            VALOR_RECUPERADO[EXT_DATALANCAMENTO]
        ),
        DATESBETWEEN ( dCalendario[Date], DataInicial, DataFinal ),
        NOT(OPERACOES[OPE_CODIGOSITUACAO-SIT_COD_N3] IN {12, 14, 15})
    )


// ============================================================================
// 10. MEDIDA: media-recuperacao_60 meses
// DESCRIÇÃO: Média mensal de recuperação de crédito obtida dividindo o total 
//            recuperado em 60 meses por 60.
// ============================================================================

media-recuperacao_60 meses = [vlr-recuperado_60meses] / 60


// ============================================================================
// 11. PARÂMETRO: Simu_Garantia_Mensal
// DESCRIÇÃO: Parâmetro What-If de entrada do usuário para simulação de concessão 
//            mensal fictícia de novas garantias.
// ============================================================================

Simu_Garantia_Mensal = GENERATESERIES(0, 100000000, 250000)
Valor Simu_Garantia_Mensal = SELECTEDVALUE('Simu_Garantia_Mensal'[Simu_Garantia_Mensal], 0)


// ============================================================================
// 12. PARÂMETRO: Simu_Honra_Mensal
// DESCRIÇÃO: Parâmetro What-If para inclusão de estimativa mensal de novas honras 
//            (inadimplência simulada).
// ============================================================================

Simu_Honra_Mensal = GENERATESERIES(0, 10000000, 10000)
Valor Simu_Honra_Mensal = SELECTEDVALUE('Simu_Honra_Mensal'[Simu_Honra_Mensal], 0)


// ============================================================================
// 13. PARÂMETRO: Simu_Recupe_Mensal
// DESCRIÇÃO: Parâmetro What-If para inserção de projeção mensal de recuperação de ativos.
// ============================================================================

Simu_Recupe_Mensal = GENERATESERIES(0, 500000, 5000)
Valor Simu_Recupe_Mensal = SELECTEDVALUE('Simu_Recupe_Mensal'[Simu_Recupe_Mensal], 0)


// ============================================================================
// 14. MEDIDA: index_IP
// DESCRIÇÃO: Índice de Perda (IP) Real da carteira. Calculado como o Perda Líquida 
//            (Honras - Recuperações) dividido pelo Valor Garantido Total em 60 meses.
// ============================================================================

index_IP = DIVIDE([vlr-honrado_60meses] - [vlr-recuperado_60meses], [vlr-garantido_60meses], 0)


// ============================================================================
// 15. MEDIDA: StopLoss_Dinamico_Hibrido
// DESCRIÇÃO: Retorna dinamicamente o histórico do Índice de Perda operacional da instituição financeira
//            selecionada ou a régua geral do Fundo se não houver seleção única.
// ============================================================================

StopLoss_Dinamico_Hibrido = 
VAR vBancoAnonimoSelecionado = SELECTEDVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vTemSelecaoUnica = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])

RETURN
IF(
    vTemSelecaoUnica && NOT ISBLANK(vBancoAnonimoSelecionado),
    CALCULATE(
        MAX('Serie_Historica_STOPLOSS IF'[STOP LOSS]),
        KEEPFILTERS(BANCOS)
    ),
    CALCULATE(
        MAX('Serie_Historica_STOPLOSS GERAL'[STOPLOSS]),
        REMOVEFILTERS(BANCOS)
    )
)


// ============================================================================
// 16. MEDIDA: dt_corte
// DESCRIÇÃO: Identifica a menor data máxima convergente entre garantias, honras 
//            e recuperações, estabelecendo a linha base segura para fechamento e projeções.
// ============================================================================

dt_corte = 
VAR vUltimaGarantia = CALCULATE(MAX(OPERACOES[OPE_DATAINICIO]), ALL(operacoes))
VAR vUltimaHonra = CALCULATE(MAX(OPERACOES[OPE_DATAEFETIVAHONRA]), ALL(operacoes))
VAR vUltimaRecup = CALCULATE(MAX(VALOR_RECUPERADO[EXT_DATALANCAMENTO]), ALL(VALOR_RECUPERADO))

VAR vDataMinimaDasMaximas = MINX({vUltimaGarantia, vUltimaHonra, vUltimaRecup}, [Value])
RETURN vDataMinimaDasMaximas


// ============================================================================
// 17. MEDIDA: IP_Linha_Tendencia
// DESCRIÇÃO: Medida de controle para alimentar o gráfico de linhas de projeção. 
//            Mapeia o Cenário selecionado no eixo X ("Atual" até "Mês +8") e 
//            retorna o respectivo valor simulado de Índice de Perda.
// ============================================================================

IP_Linha_Tendencia = 
VAR vBancoSelecionado = HASONEVALUE(bancos[BCO_NOME_ANONIMO])
VAR vSomaParametros = 
    [Valor Simu_Honra_Mensal] + 
    [Valor Simu_Recupe_Mensal] + 
    [Valor Simu_Garantia_Mensal]

VAR vCenario = SELECTEDVALUE('Tabela_Tendencia-SIMULADOR'[Cenário])

RETURN
IF(
    vBancoSelecionado, 
    IF(
        vSomaParametros = 0 && vCenario <> "Atual", 
        BLANK(),
        SWITCH( vCenario,
            "Atual", [index_IP],
            "Mês +1", [index_IP_simulado-1],
            "Mês +2", [index_IP_simulado-2],
            "Mês +3", [index_IP_simulado-3],
            "Mês +4", [index_IP_simulado-4],
            "Mês +5", [index_IP_simulado-5],
            "Mês +6", [index_IP_simulado-6],
            "Mês +7", [index_IP_simulado-7],
            "Mês +8", [index_IP_simulado-8],
            BLANK()
        )
    ),
    BLANK() 
)


// ============================================================================
// 18 A 25. MEDIDAS DE PROJEÇÃO SIMULADA (Mês +1 até Mês +8)
// DESCRIÇÃO MODELO: Aplica a lógica de expurgo do mês mais antigo da janela de 60 meses 
//                  (vHonraSair, vRecupSair, vGarantiaSair) e adiciona os novos parâmetros 
//                  simulados multiplicados pela quantidade do horizonte futuro (1 a 8 meses).
// ============================================================================

// --- MÊS +1 ---
index_IP_simulado-1 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 0)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 1)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 1)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 1)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +2 ---
index_IP_simulado-2 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 1)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 2)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 2)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 2)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +3 ---
index_IP_simulado-3 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 2)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 3)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 3)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 3)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +4 ---
index_IP_simulado-4 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 3)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 4)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 4)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 4)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +5 ---
index_IP_simulado-5 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 4)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 5)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 5)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 5)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +6 ---
index_IP_simulado-6 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 5)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 6)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 6)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 6)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +7 ---
index_IP_simulado-7 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 6)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 7)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 7)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 7)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// --- MÊS +8 ---
index_IP_simulado-8 = 
VAR vBancoSelecionado = HASONEVALUE(BANCOS[BCO_NOME_ANONIMO])
VAR vDataCorte = [dt_corte]
VAR vDataMesExpurgo = EDATE(DATE(YEAR(vDataCorte), MONTH(vDataCorte), 1), -59)
VAR vInicioExpurgo = vDataMesExpurgo
VAR vFimExpurgo = EOMONTH(vDataMesExpurgo, 7)

VAR vHonraSair = CALCULATE(SUM(operacoes[OPE_VALOREFETIVOHONRA]), operacoes[OPE_DATAEFETIVAHONRA] >= vInicioExpurgo, operacoes[OPE_DATAEFETIVAHONRA] <= vFimExpurgo)
VAR vRecupSair = CALCULATE(SUM(VALOR_RECUPERADO[VLRRECUPERADO]), VALOR_RECUPERADO[EXT_DATALANCAMENTO] >= vInicioExpurgo, VALOR_RECUPERADO[EXT_DATALANCAMENTO] <= vFimExpurgo)
VAR vGarantiaSair = CALCULATE(SUM(operacoes[OPE_VALORGARANTIA]), operacoes[OPE_DATAINICIO] >= vInicioExpurgo, operacoes[OPE_DATAINICIO] <= vFimExpurgo)

VAR vNovoHonrado = ([vlr-honrado_60meses] - vHonraSair) + ([Valor Simu_Honra_Mensal] * 8)
VAR vNovoRecuperado = ([vlr-recuperado_60meses] - vRecupSair) + ([Valor Simu_Recupe_Mensal] * 8)
VAR vNovoGarantido = ([vlr-garantido_60meses] - vGarantiaSair) + ([Valor Simu_Garantia_Mensal] * 8)

VAR vResultado = DIVIDE(vNovoHonrado - vNovoRecuperado, vNovoGarantido, 0)

RETURN
IF(vBancoSelecionado && NOT ISBLANK(vDataCorte), vResultado, "-")


// ============================================================================
// 26. MEDIDA: Titulo_Grafico_Historico
// DESCRIÇÃO: Título dinâmico para o gráfico histórico que altera o rótulo da tela 
//            de acordo com o banco selecionado ou exibe visão consolidada do Fundo.
// ============================================================================

Titulo_Grafico_Historico = 
VAR vBanco = SELECTEDVALUE(BANCOS[BCO_NOME_ANONIMO])

RETURN
IF(
    ISBLANK(vBanco),
    "Histórico Índice de Perda - FUNDO",
    "Histórico Índice de Perda - " & vBanco
)


// ============================================================================
// 27. MEDIDA: Titulo_Grafico_Simulacao
// DESCRIÇÃO: Título dinâmico para a área de projeção que orienta o usuário a inserir 
//            parâmetros ou confirma a exibição da tendência dos próximos 8 meses.
// ============================================================================

Titulo_Grafico_Simulacao = 
IF(
    [Valor Simu_Honra_Mensal] + [Valor Simu_Recupe_Mensal] + [Valor Simu_Garantia_Mensal] = 0,
    "Aguardando Parâmetros para Projeção do Índice de Perda...",
    "Tendência do Índice de Perda (Próximos 8 meses)"
)
